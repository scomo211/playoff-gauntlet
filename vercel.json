{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.playoffgauntlet.com" }],
      "destination": "https://playoffgauntlet.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/update-projections",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/send-lineup-reminders",
      "schedule": "0 * * * *"
    }
  ]
}
